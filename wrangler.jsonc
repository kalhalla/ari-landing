{
  // Cloudflare Workers static-assets config for learnwithari.co.uk.
  // html_handling "none" keeps the .html URLs exactly as they were on Vercel,
  // so the short links in _redirects (/drone -> /drone.html?utm...) don't loop.
  "name": "ari-landing",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./",
    "html_handling": "none",
    "not_found_handling": "none"
  }
}
